        ...
    def modules(self) -> list[br3k.pe.imports.Module]:
        """
        Return snapshots of the model's module records.
        """
        ...
    def imports(self) -> list[br3k.pe.imports.Function]:
        """
        Return snapshots of the model's function records and recovery evidence.
        """
        ...
    def validate(self, *, symbols: br3k.pe.exports.Symbols = ...) -> list[br3k.pe.imports.Issue]:
