    Error = ...
    """
    Structural or unresolved-target problem requiring attention before a complete build.
    """
    Warning = ...
    """
    Inconsistency that should be reviewed.
    """
    Suspect = ...
    """
    Heuristic pattern that may warrant closer inspection.
    """

class LookupKind(IntEnum):
